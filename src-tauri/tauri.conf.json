{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevStack Manager",
  "version": "0.2.0",
  "identifier": "com.devstack.manager",
  "build": {
    "beforeDevCommand": "pnpm --filter @devstack/renderer dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @devstack/renderer build",
    "frontendDist": "../apps/renderer/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevStack Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": ["../catalog"],
    "publisher": "kang",
    "shortDescription": "Manage developer tools like an app store",
    "longDescription": "DevStack Manager helps you discover, install, and manage developer tools on Windows, macOS and Linux."
  }
}
