{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for AutoInstallManager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:menu:default",
    "core:resources:default",
    "core:tray:default",
    "core:image:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
